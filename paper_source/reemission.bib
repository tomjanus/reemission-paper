@Article{Barros2011,
  author   = {Barros, Nathan and Cole, Jonathan J. and Tranvik, Lars J. and Prairie, Yves T. and Bastviken, David and Huszar, Vera L. M. and del Giorgio, Paul and Roland, F{\'a}bio},
